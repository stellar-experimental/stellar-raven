{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stellar-raven-codemode",
  "main": "src/server.ts",
  // Static brand and listing images. A request for a file in public/ gets the
  // file without running the Worker; every other request reaches the Worker.
  // public/_headers sets their cache, nosniff, and CSP headers.
  "assets": { "directory": "./public" },
  // Keep the compatibility date at 2026-06-11 or later, with nodejs_compat
  // (matches Cloudflare's codemode-mcp-openapi reference example).
  "compatibility_date": "2026-06-11",
  // global_fetch_strictly_public: all global fetches resolve as public
  // internet (SSRF-safe), which lets workers-oauth-provider enable CIMD —
  // URL-based client_ids so MCP clients can skip dynamic registration. Safe
  // here: every host-side fetch (Lumenloop, Scout, Algolia, WorkOS) is a
  // public hostname and the execute sandbox has no network at all.
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  // Dynamic Workers / Worker Loader binding for the `execute` tool
  // (DynamicWorkerExecutor). Open beta, Workers Paid in production; works in
  // local dev on any plan. Load-bearing: every `execute` call loads its
  // sandbox isolate through this binding.
  "worker_loaders": [
    {
      "binding": "LOADER"
    }
  ],
  // Workers AI binding for the /playground chat. Model calls route through
  // Workers AI / AI Gateway Unified Billing. src/demo/model-config.ts owns the
  // primary and fallback model IDs. Playground-only: the MCP surface never
  // touches this binding.
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "vars": {
    // AI Gateway every /playground model call routes through. Gateway-side
    // limits are the account-level cost backstop — per-request caps alone
    // don't bound aggregate spend. Uses the dedicated gateway, whose
    // rate-limit / spend-limit rules are dashboard-side config — keep at
    // least one spend-limit rule on it while /playground is live.
    "DEMO_AI_GATEWAY_ID": "stellar-raven-demo",
    // Execute result/log/error model-boundary cap (about 6k tokens). Raise
    // only for measured truncation review.
    "EXECUTE_MODEL_BOUNDARY_MAX_TOKENS": "6000"
  },
  // Token/client/grant storage for @cloudflare/workers-oauth-provider plus
  // named API-key digests under raven:api-key:v1:. The binding MUST be named
  // OAUTH_KV — the OAuth library reads it by that name.
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "6a5d8d2c8f8a409882a15f8f32bc3a96"
    }
  ],
  // Auth-bound execute result artifacts. Host code enforces 7-day logical
  // expiry; the bucket lifecycle also expires objects after 7 days.
  "r2_buckets": [
    {
      "binding": "ARTIFACTS",
      "bucket_name": "stellar-raven-artifacts",
      "preview_bucket_name": "stellar-raven-artifacts-dev"
    }
  ],
  // Production hostnames: raven.stellar.org is the canonical route; the two
  // stellar.buzz hosts are aliases (they keep the WorkOS redirect-URI
  // registrations valid and serve existing clients). Ignored by local
  // wrangler dev. workers.dev stays off: the custom domains are the only
  // front door.
  "routes": [
    // raven.stellar.org arrives via Cloudflare for SaaS on the stellar.buzz
    // zone (custom hostname + CNAME to proxy-fallback.stellar.buzz). Without
    // this route the custom-hostname traffic falls through to the zone's
    // fallback origin instead of this worker.
    {
      "pattern": "raven.stellar.org/*",
      "zone_name": "stellar.buzz"
    },
    {
      "pattern": "raven.stellar.buzz",
      "custom_domain": true
    },
    {
      "pattern": "agents.stellar.buzz",
      "custom_domain": true
    }
  ],
  "workers_dev": false,
  // Persist usage metadata after each invocation. No model or adapter binding.
  "tail_consumers": [{ "service": "stellar-raven-usage" }],
  // Skill-availability canary (src/skills/canary.ts). Hourly, because this is
  // the ONLY detector for a Cloudflare-side failure of the serve-don't-store
  // path: skill bodies are fetched from raw.githubusercontent.com at request
  // time, and every other check runs on a GitHub Actions runner, which cannot
  // observe Worker egress. The `scheduled` handler fetches every pinned file
  // with the caches deliberately bypassed and stores a verdict; the daily
  // refresh reads it via GET /health/skills. Hourly keeps the staleness window
  // well inside that daily read. Cost is ~30 full GETs (~370 KB) per run — no
  // conditional headers are sent, because the bytes are what gets verified.
  "triggers": {
    "crons": ["7 * * * *"]
  },
  "observability": {
    "enabled": true,
    // Traces (open beta): auto-instruments host-side adapter fetches +
    // handler spans; Worker Loader isolates are NOT auto-instrumented — the
    // execute boundary gets a custom span (tracing.enterSpan in
    // src/executor/run.ts). Spans bill as observability events shared with
    // Workers Logs. Cloudflare docs currently drift on the included Paid
    // event count: Workers Logs says 20M/month, while the traces pricing page
    // still says 10M/month; confirm in the dashboard/API before exact budget
    // math. Traffic is low, so 100% sampling. Full survey:
    // research/observability-cloudflare.md and ideas/observability-r2-retention.md.
    "traces": {
      "enabled": true
    }
  },
  // Readable production stack traces in Workers Logs (bundle is esbuild
  // output; without maps, errors point at minified positions).
  "upload_source_maps": true
  // NOTE: stateless server (ARCHITECTURE.md) — deliberately no Durable Object
  // bindings/migrations. Secrets (LUMENLOOP_API_KEY, ALGOLIA_{APPLICATION_ID,API_KEY}_{DOCS,SITE},
  // WORKOS_CLIENT_ID, WORKOS_API_KEY,
  // MCP_SERVER_SECRET) go via `wrangler secret put` in prod and `.dev.vars`
  // locally. DEV_ALLOW_UNAUTHENTICATED lives ONLY in `.dev.vars` (auth
  // bypass for local dev) — never deploy it as a var or secret. Even if it
  // WERE deployed it is inert: gate.ts honors it only on a loopback hostname
  // (localhost/127.0.0.1/::1), never on the public domain.
}
