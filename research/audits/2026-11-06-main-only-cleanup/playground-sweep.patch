@@ -0,0 +1,130 @@
+import { mkdtemp, rm, writeFile, chmod } from "node:fs/promises";
+import os from "node:os";
+import path from "node:path";
+import { afterEach, describe, expect, it } from "vitest";
+import {
+  CODEX_JUDGE_EFFORT,
+  JUDGE_CLI_IDS,
+  JUDGE_RUBRIC,
+  SUBSCRIPTION_NO_USD_FIGURE,
+  buildCodexJudgeArgs,
+  buildJudgeArgs,
+  judgeCase,
+  parseCodexJudgeOutput
+} from "../eval/qa/judge.mjs";
+
+const scratch = [];
+afterEach(async () => {
+  await Promise.all(scratch.splice(0).map((dir) => rm(dir, { recursive: true, force: true })));
+});
+
+/** A stand-in judge executable that prints fixed stdout and exits with a status. */
+async function stubCli(stdout, { status = 0 } = {}) {
+  const dir = await mkdtemp(path.join(os.tmpdir(), "judge-cli-stub-"));
+  scratch.push(dir);
+  const file = path.join(dir, "stub.sh");
+  const out = path.join(dir, "stdout.txt");
+  await writeFile(out, stdout);
+  await writeFile(file, `#!/bin/sh\ncat >/dev/null\ncat ${JSON.stringify(out)}\nexit ${status}\n`);
+  await chmod(file, 0o755);
+  return file;
+}
+
+const CASE = {
+  id: "selftest-cli-adapter",
+  question: "Which command builds a Soroban contract to Wasm?",
+  golden: { answer: "`stellar contract build`.", keyFacts: ["stellar contract build"], avoid: [], notes: "" },
+  tags: {},
+  candidateAnswer: "Use `stellar contract build`.",
+  transcript: []
+};
+
+const VERDICT = {
+  score: "correct",
+  coreAnswer: "correct",
+  missingFacts: [],
+  wrongClaims: [],
+  avoidMatches: [],
+  rationale: "Names the build command."
+};
+
+describe("judge CLI adapters", () => {
+  it("exposes exactly two judge CLIs and keeps Claude as the default contract", () => {
+    expect([...JUDGE_CLI_IDS]).toEqual(["claude", "codex"]);
+    expect(buildJudgeArgs({ model: "claude-sonnet-5" })[0]).toBe("-p");
+  });
+
+  it("builds read-only, approval-free, config-free Codex arguments with the prompt on stdin", () => {
+    const args = buildCodexJudgeArgs({ model: "gpt-6.1-sol" });
+    expect(args.slice(0, 3)).toEqual(["-a", "never", "exec"]);
+    expect(args).toContain("read-only");
+    expect(args).toContain("--ephemeral");
+    expect(args).toContain("--ignore-user-config");
+    expect(args).toContain("--ignore-rules");
+    expect(args).toContain("--json");
+    expect(args.at(-1)).toBe("-");
+    expect(args[args.indexOf("-m") + 1]).toBe("gpt-6.1-sol");
+    expect(args[args.indexOf("-c") + 1]).toBe(`model_reasoning_effort="${CODEX_JUDGE_EFFORT}"`);
+    expect(args.join(" ")).not.toMatch(/bypass|approve-for-me|workspace-write|full-access/);
+    expect(buildCodexJudgeArgs({ model: "gpt-6.1-sol", effort: "medium" })).toContain('model_reasoning_effort="medium"');
+    expect(() => buildCodexJudgeArgs({ model: "gpt-6.1-sol", effort: "max" })).toThrow(/effort must be one of/);
+    expect(() => buildCodexJudgeArgs({})).toThrow(/requires a model id/);
+  });
+
+  it("reads the last agent message and the usage out of Codex JSONL", () => {
+    const stdout = [
+      '{"type":"thread.started","thread_id":"t"}',
+      '{"type":"turn.started"}',
+      "not json",
+      '{"type":"item.completed","item":{"id":"i0","type":"reasoning","text":"thinking"}}',
+      '{"type":"item.completed","item":{"id":"i1","type":"agent_message","text":"draft"}}',
+      '{"type":"item.completed","item":{"id":"i2","type":"agent_message","text":"{\\"score\\":\\"partial\\"}"}}',
+      '{"type":"turn.completed","usage":{"input_tokens":10,"output_tokens":2}}'
+    ].join("\n");
+    expect(parseCodexJudgeOutput(stdout)).toEqual({
+      resultText: '{"score":"partial"}',
+      usage: { input_tokens: 10, output_tokens: 2 },
+      error: null
+    });
+    expect(parseCodexJudgeOutput("")).toEqual({ resultText: null, usage: null, error: null });
+    expect(parseCodexJudgeOutput('{"type":"error","message":"rate limited"}').error).toBe("rate limited");
+  });
+
+  it("grades through the Codex adapter with a zero, labeled cost and recorded usage", async () => {
+    const stdout = [
+      '{"type":"item.completed","item":{"type":"agent_message","text":' + JSON.stringify(JSON.stringify(VERDICT)) + "}}",
+      '{"type":"turn.completed","usage":{"input_tokens":12,"output_tokens":3}}'
+    ].join("\n");
+    const command = await stubCli(stdout);
+    const verdict = await judgeCase(CASE, { cli: "codex", command, model: "gpt-6.1-sol" });
+    expect(verdict.score).toBe("correct");
+    expect(verdict.costUsd).toBe(0);
+    expect(verdict.costBasis).toBe(SUBSCRIPTION_NO_USD_FIGURE);
+    expect(verdict.usage).toEqual({ input_tokens: 12, output_tokens: 3 });
+    expect(verdict.rubric).toBe(JUDGE_RUBRIC);
+  });
+
+  it("labels a Codex CLI failure and an unparseable Codex verdict without inventing a cost", async () => {
+    const failing = await stubCli("", { status: 2 });
+    const failure = await judgeCase(CASE, { cli: "codex", command: failing, model: "gpt-6.1-sol" });
+    expect(failure.score).toBe("error");
+    expect(failure.failureClass).toBe("cli");
+    expect(failure.costUsd).toBe(0);
+    expect(failure.costBasis).toBe(SUBSCRIPTION_NO_USD_FIGURE);
+
+    const prose = await stubCli('{"type":"item.completed","item":{"type":"agent_message","text":"I cannot grade this."}}');
+    const unparseable = await judgeCase(CASE, { cli: "codex", command: prose, model: "gpt-6.1-sol" });
+    expect(unparseable.score).toBe("error");
+    expect(unparseable.failureClass).toBe("parse");
+    expect(unparseable.rationale).toContain("I cannot grade this.");
+  });
+
+  it("keeps the Claude adapter's envelope cost and rejects unknown CLIs", async () => {
+    const command = await stubCli(JSON.stringify({ result: JSON.stringify(VERDICT), total_cost_usd: 0.0123 }));
+    const verdict = await judgeCase(CASE, { command, model: "claude-sonnet-5" });
+    expect(verdict.score).toBe("correct");
+    expect(verdict.costUsd).toBe(0.0123);
+    expect(verdict.costBasis).toBeUndefined();
+    await expect(judgeCase(CASE, { cli: "gemini", command })).rejects.toThrow(/unknown judge cli gemini/);
+  });
+});
