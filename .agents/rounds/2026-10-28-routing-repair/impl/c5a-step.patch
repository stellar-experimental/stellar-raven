+const commonRoutingTokensCache = new WeakMap<Catalog, ReadonlySet<string>>();
+
+/** Source tokens shared by a majority of searchable entries do not identify intent. */
+function commonRoutingTokens(catalog: Catalog): ReadonlySet<string> {
+  const cached = commonRoutingTokensCache.get(catalog);
+  if (cached) return cached;
+  const entries = catalog.entries.filter((entry) =>
+    entry.searchable !== false && entry.kind !== "skill-section"
+  );
+  const frequencies = new Map<string, number>();
+  for (const entry of entries) {
+    const tokens = new Set(tokenize([
+      entry.id, entry.description, ...(entry.routingKeywords ?? [])
+    ].join(" ")).map(canonicalRoutingToken));
+    for (const token of tokens) frequencies.set(token, (frequencies.get(token) ?? 0) + 1);
+  }
+  const common = new Set([...frequencies]
+    .filter(([, count]) => count > entries.length / 2)
+    .map(([token]) => token));
+  commonRoutingTokensCache.set(catalog, common);
+  return common;
+}
