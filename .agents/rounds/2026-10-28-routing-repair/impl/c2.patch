+/** Keep schema rank evidence inside its own token boundary. */
+function schemaAugmentedScore(
+  entry: WeightedScorableEntry,
+  query: PreparedQueryForm,
+  keywords: readonly string[],
+  score: EntryScorer
+): number | null {
+  const description = `${entry.description} ${joinedKeywords(keywords)}`;
+  const augmented = score({ ...entry, description }, query);
+  if (augmented === null) return null;
+  const normalized = normalizeSearchText(query.query);
+  const before = scoreFieldUngated(normalized, query.tokens, entry.description, 5);
+  const after = scoreFieldUngated(normalized, query.tokens, description, 5);
+  const vocabulary = new Set(keywords.map(canonicalRoutingToken));
+  const allowed = new Set(query.tokens.filter((token) =>
+    vocabulary.has(canonicalRoutingToken(token))
+  ));
+  let unsupported = 0;
+  for (const token of query.tokens) {
+    if (allowed.has(token)) continue;
+    unsupported += Math.max(0,
+      scoreFieldUngated("", [token], description, 5).score -
+      scoreFieldUngated("", [token], entry.description, 5).score
+    );
+  }
+  const baseMatches = new Set<string>();
+  for (const [field, weight] of Object.entries(UNGATED_FIELD_WEIGHTS)) {
+    const original = scoreFieldUngated(normalized, query.tokens,
+      entry[field as keyof ScorableEntry], weight);
+    for (const token of original.matchedTokens) baseMatches.add(token);
+  }
+  const allMatches = new Set([...baseMatches, ...after.matchedTokens]);
+  const cleanMatches = new Set([...baseMatches,
+    ...[...after.matchedTokens].filter((token) => allowed.has(token))]);
+  const bonus = (size: number) => size === query.tokens.length
+    ? 25 : Math.round(size / query.tokens.length * 10);
+  unsupported += bonus(allMatches.size) - bonus(cleanMatches.size);
+  const phraseAllowed = query.tokens.every((token) =>
+    before.matchedTokens.has(token) || allowed.has(token)
+  );
+  if (!phraseAllowed) {
+    const phraseScore = (value: string) => scoreFieldUngated(normalized, [], value, 5).score;
+    unsupported += Math.max(0, phraseScore(description) - phraseScore(entry.description));
+  }
+  return augmented - unsupported;
+}
