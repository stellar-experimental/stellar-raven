+/** Whole schema-token matches rank independently admitted entries without adding coverage. */
+function addKeywordRank(
+  entry: WeightedScorableEntry,
+  query: PreparedScoringQuery,
+  admitted: number | null
+): number | null {
+  if (admitted === null || !entry.keywords?.length) return admitted;
+  const vocabulary = new Set(tokenize(joinedKeywords(entry.keywords)).map(canonicalRoutingToken));
+  const matches = (form: PreparedQueryForm) => new Set(
+    form.tokens.map(canonicalRoutingToken).filter((token) => vocabulary.has(token))
+  ).size;
+  const count = Math.max(matches(query.original), query.canonical ? matches(query.canonical) : 0);
+  const kindWeight = entry.kind === "skill-section" ? 0.75 : 1;
+  return admitted + Math.round(count * UNGATED_FIELD_WEIGHTS.description * 4 * KEYWORD_BLEND * kindWeight);
